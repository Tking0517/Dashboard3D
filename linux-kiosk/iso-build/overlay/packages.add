# Extra packages baked into the Dashboard3D appliance ISO.
# container-build.sh strips comments/blank lines and appends the rest to
# the releng profile's packages.x86_64.

# --- compositor / graphics (open stack — drives AMD, Intel, and NVIDIA
#     via nouveau/NVK; the safest default for booting an unknown laptop) ---
gamescope
mesa
lib32-mesa
vulkan-icd-loader
lib32-vulkan-icd-loader
vulkan-radeon
lib32-vulkan-radeon
vulkan-intel
lib32-vulkan-intel
vulkan-nouveau
lib32-vulkan-nouveau

# --- NVIDIA driver (for the dGPU in Game Mode) ---
# nvidia-open = NVIDIA's open kernel modules (Arch's current default;
# fully supports Turing/Ampere+ incl. the RTX 3080). Blacklisted from
# auto-load (see modprobe.d/dashboard3d.conf) so the dashboard boot stays
# on the AMD APU exactly as before; Game Mode modprobes it on demand.
nvidia-open
nvidia-utils
lib32-nvidia-utils

# --- Electron runtime libraries (the packaged app links these) ---
gtk3
nss
alsa-lib
libnotify
libxss
libxtst
at-spi2-core

# --- audio ---
pipewire
pipewire-pulse
pipewire-alsa
wireplumber

# --- network ---
networkmanager

# --- gaming ---
steam
gamemode
lib32-gamemode
mangohud
lib32-mangohud

# --- Steam-as-windowed-app session (replaces the gamescope+bigpicture
#     path which kept hanging on DRM master / connector issues). startx
#     brings up a minimal Xorg + openbox + Steam desktop client. Steam
#     opens as a normal window, the user clicks Library + Launch like
#     on any other desktop. When Steam exits, X exits, we return to
#     the dashboard. ---
xorg-server
xorg-xinit
openbox
# X11 input driver — Xorg has NO keyboard / mouse / touchpad without it.
# It is NOT a hard dependency of xorg-server, so it must be listed
# explicitly or input silently fails on the appliance.
xf86-input-libinput
# setxkbmap — the X session forces a clean pc105/us keymap at startup
# (see dashboard3d-session.sh and xorg.conf.d/00-keyboard.conf).
xorg-setxkbmap

# --- input / media + brightness key daemon (volume keys -> wpctl,
#     brightness keys -> brightnessctl; the appliance has no DE to
#     handle the Fn keys for us) ---
python
python-evdev
brightnessctl

# --- X session + on-device maintenance tools ---
# xdotool is used by the X session itself (the kiosk focus assist in
# dashboard3d-session.sh); xterm + xorg-xinput are kept for keyboard /
# input debugging from a maintenance tty.
xdotool
xterm
xorg-xinput

# --- fonts ---
noto-fonts
ttf-dejavu
